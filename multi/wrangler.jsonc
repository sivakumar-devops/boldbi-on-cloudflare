{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boldbi-multi",
  "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
  "main": "worker.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "IdWebContainer",
      "image": "./Dockerfile.id-web",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "IdApiContainer",
      "image": "./Dockerfile.id-api",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "IdUmsContainer",
      "image": "./Dockerfile.id-ums",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "BiWebContainer",
      "image": "./Dockerfile.bi-web",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "BiApiContainer",
      "image": "./Dockerfile.bi-api",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "BiJobsContainer",
      "image": "./Dockerfile.bi-jobs",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "BiDesignerContainer",
      "image": "./Dockerfile.bi-designer",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "BiEtlContainer",
      "image": "./Dockerfile.bi-etl",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "BoldAiContainer",
      "image": "./Dockerfile.bold-ai",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "BoldMcpContainer",
      "image": "./Dockerfile.bold-mcp",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ID_WEB_CONTAINER",
        "class_name": "IdWebContainer"
      },
      {
        "name": "ID_API_CONTAINER",
        "class_name": "IdApiContainer"
      },
      {
        "name": "ID_UMS_CONTAINER",
        "class_name": "IdUmsContainer"
      },
      {
        "name": "BI_WEB_CONTAINER",
        "class_name": "BiWebContainer"
      },
      {
        "name": "BI_API_CONTAINER",
        "class_name": "BiApiContainer"
      },
      {
        "name": "BI_JOBS_CONTAINER",
        "class_name": "BiJobsContainer"
      },
      {
        "name": "BI_DESIGNER_CONTAINER",
        "class_name": "BiDesignerContainer"
      },
      {
        "name": "BI_ETL_CONTAINER",
        "class_name": "BiEtlContainer"
      },
      {
        "name": "BOLD_AI_CONTAINER",
        "class_name": "BoldAiContainer"
      },
      {
        "name": "BOLD_MCP_CONTAINER",
        "class_name": "BoldMcpContainer"
      }
    ]
  },
  "exports": {
    "IdWebContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "IdApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "IdUmsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BiWebContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BiApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BiJobsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BiDesignerContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BiEtlContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BoldAiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BoldMcpContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
